    style PGDB fill:#e8f4fd,stroke:#2196F3,stroke-dasharray:5 5
    style COMP_RPT fill:#e8f4fd,stroke:#2196F3,stroke-dasharray:5 5
    style GITLAB_CI fill:#e8f4fd,stroke:#2196F3,stroke-dasharray:5 5
    style JENKINS fill:#e8f4fd,stroke:#2196F3,stroke-dasharray:5 5
